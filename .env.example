# Dual-database rollout modes: legacy | shadow | cockroach | cockroach-readonly-legacy-backup
DB_MODE=legacy

# CockroachDB / PostgreSQL-wire primary. Set in the deployment secret manager.
COCKROACH_DATABASE_URL=postgresql://<user>:<password>@<host>:26257/<database>?sslmode=verify-full

# Existing MySQL/MariaDB backup/source. Set in the deployment secret manager.
LEGACY_DATABASE_URL=mysql://<user>:<password>@<host>:3306/<database>

DB_SHADOW_SAMPLE_RATE=0.05
DB_OUTBOX_BATCH_SIZE=100
