  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "sh -c 'NODE_ENV=development PORT=3001 tsx server/index.ts & api_pid=$!; trap \"kill $api_pid\" EXIT INT TERM; vite --host'",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "format": "prettier --write .",
    "db:translate-mysql": "tsx scripts/translate-mysql-migrations.ts",
    "db:translate-mysql:check": "tsx scripts/translate-mysql-migrations.ts --check",
    "db:migrate:cursor-indexes": "tsx scripts/migrate-cursor-indexes.ts",
    "db:snapshot:mysql": "tsx scripts/snapshot-mysql-schema.ts"
  },
