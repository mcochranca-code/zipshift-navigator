flowchart LR
  Browser["Browser / PWA"] --> Vite["Vite + React 19\nTailwind CSS + shadcn/ui"]
  Vite --> Router["App.tsx + Wouter\nrole-aware screen routing"]
  Router --> Public["Client-facing flows\nresource search, consent, profile"]
  Router --> Staff["Staff workspace\nreferrals, YellowBook, field tools"]
  Router --> Care["Care coordination\nintake, documents, milestones, tasks"]
  Router --> Research["Research workspace\nstudies, instruments, analytics"]

  Vite --> API["Express API\nserver/index.ts"]
  API --> Auth["Auth + session safeguards"]
  API --> Directory["Directory + resource APIs"]
  API --> Workflow["Referral, case, intake\nand coordination workflows"]
  API --> ResearchAPI["Study, consent, participant\nand assessment APIs"]
  API --> Admin["Admin pages, settings\nand audit APIs"]

  API --> MySQL[("MySQL / MariaDB\nrelational application data")]
  API --> Storage["Object storage\nprivate PDFs, signatures, files"]
  API --> Static["dist/public\nstatic client assets"]

  Migrations["server/migrations\nordered SQL migrations"] --> MySQL
  Shared["shared/\nconstants + referral rules"] --> Vite
  Shared --> API
  Field["FieldOperationsContext\nlocal queue + privacy mode"] --> Staff
  Field --> BrowserStorage["localStorage\nqueue, language, dock visibility"]

